# This repo standardizes on pnpm: its lockfile is committed (CI uses
# --frozen-lockfile; Renovate lockFileMaintenance keeps it fresh).
# Other package managers' lockfiles stay ignored to prevent drift.
package-lock.json
yarn.lock

# Claude Code: track .claude/settings.json only; keep per-machine / transient state out
